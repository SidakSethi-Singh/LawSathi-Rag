# LawSaathi-RAG Environment Configuration

# OpenAI / Remote API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Local LLM Configuration (e.g. Ollama)
# Set to true to route prompts to local Ollama instead of OpenAI
USE_LOCAL_MODEL=false

# Base URL for local Ollama or custom OpenAI-compatible endpoint
# For Ollama default: http://localhost:11434
# For NVIDIA NIM default: https://integrate.api.nvidia.com/v1
API_BASE_URL=http://localhost:11434

# LLM Model Name
MODEL_NAME=gpt-4o-mini
# Or for local: llama3.1
